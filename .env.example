# AXIOM runtime configuration
AXIOM_PORT=8080
AXIOM_ENV=production
AXIOM_LOG_LEVEL=info

# PostgreSQL credentials (set strong values in .env)
POSTGRES_USER=axiom
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=axiom

# Internal service URLs
DATABASE_URL=postgresql://<user>:<pass>@axiom-db:5432/<db>?sslmode=disable
AXIOM_INTERNAL_URL=http://axiom-web:8080

# Proxy / TLS configuration
DOMAIN=localhost
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
