# AXIOM runtime configuration
AXIOM_PORT=8080
AXIOM_ENV=production
AXIOM_LOG_LEVEL=info
AXIOM_MAX_REQUEST_BODY_BYTES=65536
# Cap for /api/axiom/uploads (public-page attach button, admin-gated).
# Mirrors the engine's own AXIOM_SOURCE_UPLOAD_MAX_BYTES cap.
AXIOM_MAX_UPLOAD_BODY_BYTES=5242880

# PostgreSQL credentials (set strong values in .env)
POSTGRES_USER=axiom
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=axiom

# Internal service URLs
DATABASE_URL=postgresql://<user>:<pass>@axiom-db:5432/<db>?sslmode=disable
AXIOM_INTERNAL_URL=http://axiom-web:8080
AXIOM_ENGINE_URL=http://axiom-engine:3000
AXIOM_MEMORY_DIRECTORY=/app/data
# Optional warning only. This does not cap, delete, or replace AXI memory.
AXIOM_MEMORY_WARNING_BYTES=
# Compose mounts these host locations separately from ./axiom_memory.
# Choose a durable host volume for backups; a distinct local path alone does not prove independent recovery.
AXIOM_BACKUP_HOST_DIRECTORY=./axiom_backups
# Restore only into this separate staging mount; it never overwrites live memory or backups.
AXIOM_RECOVERY_RESTORE_HOST_DIRECTORY=./axiom_recovery_staging

# Opt-in private engine operations. Enable monitoring before enabling the
# scheduler; both remain private to the AXIOM engine network.
AXIOM_AUTOMATION_ENABLED=false
AXIOM_AUTOMATION_POLL_INTERVAL_MS=60000
AXIOM_AUTOMATION_MAX_TASKS_PER_CYCLE=5
AXIOM_MONITORING_ENABLED=false
AXIOM_MONITORING_POLL_INTERVAL_MS=60000

# Optional, founder-configured repository allowlist for workflow continuity.
# Blank disables ingestion; only the private engine uses this setting.
AXIOM_WORKFLOW_RUN_CONTINUITY_REPOSITORY=

# OpenAI chat provider (set the key only in local .env or a deployment secret store)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Admin auth (set strong values only in local .env or a deployment secret store)
# Gates this service's own /command-center and /support routes (HTTP Basic Auth).
ADMIN_PASSWORD=
# Forwarded as Basic Auth when this proxy calls axiom-engine's mutating routes.
# Must exactly match the AXIOM_ENGINE_ADMIN_PASSWORD configured on axiom-engine.
AXIOM_ENGINE_ADMIN_PASSWORD=

# Proxy / TLS configuration
DOMAIN=localhost
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
