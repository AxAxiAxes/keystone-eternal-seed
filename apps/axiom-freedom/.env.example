# AXIOM runtime configuration
AXIOM_PORT=8080
AXIOM_ENV=production
AXIOM_LOG_LEVEL=info

# PostgreSQL credentials (set strong values in .env)
POSTGRES_USER=axiom
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=axiom

# Internal service URLs
DATABASE_URL=postgresql://<user>:<pass>@axiom-db:5432/<db>?sslmode=disable
AXIOM_INTERNAL_URL=http://axiom-web:8080
AXIOM_ENGINE_URL=http://axiom-engine:3000
AXIOM_MEMORY_DIRECTORY=/app/data

# Opt-in private engine operations. Enable monitoring before enabling the
# scheduler; both remain private to the AXIOM engine network.
AXIOM_AUTOMATION_ENABLED=false
AXIOM_AUTOMATION_POLL_INTERVAL_MS=60000
AXIOM_AUTOMATION_MAX_TASKS_PER_CYCLE=5
AXIOM_MONITORING_ENABLED=false
AXIOM_MONITORING_POLL_INTERVAL_MS=60000

# OpenAI chat provider (set the key only in local .env or a deployment secret store)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Proxy / TLS configuration
DOMAIN=localhost
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
