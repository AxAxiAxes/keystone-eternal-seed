# AXIOM engine runtime configuration
PORT=3000

# Admin auth (set a strong value only in local .env or a deployment secret store).
# Gates every state-mutating route (checkpoints, backups/restore, automation
# profile activate/pause/resume, coordinates, bead passports, memory writes,
# and /axiom chat). Read-only status routes stay open. Fails closed if unset.
AXIOM_ENGINE_ADMIN_PASSWORD=

# Storage locations
AXIOM_MEMORY_DIRECTORY=./data
AXIOM_BACKUP_DIRECTORY=
AXIOM_RECOVERY_RESTORE_DIRECTORY=

# Opt-in private engine operations (both remain private to the AXIOM engine network)
AXIOM_AUTOMATION_ENABLED=false
AXIOM_AUTOMATION_POLL_INTERVAL_MS=60000
AXIOM_AUTOMATION_MAX_TASKS_PER_CYCLE=5
AXIOM_MONITORING_ENABLED=false
AXIOM_MONITORING_POLL_INTERVAL_MS=60000

# OpenAI chat provider (set the key only in local .env or a deployment secret store)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AXIOM_CHAT_MAX_MESSAGE_CHARACTERS=4000

# Raw source-file uploads (see docs/AXI_SOURCE_CATALOG.md). Stored locally
# under AXIOM_MEMORY_DIRECTORY/uploads; never uploaded anywhere else.
AXIOM_SOURCE_UPLOAD_MAX_BYTES=5242880

# GitHub visibility and write actions (pull requests, issues, repository
# metadata; comment/open-PR/merge-PR -- founder-approved 2026-09-15). Off by
# default -- unset means /system/github reports "not configured" and every
# route returns 503. Set only if you have generated a fine-grained Personal
# Access Token yourself (Pull requests + Issues: read and write), scoped to
# exactly one repository; AXI cannot create one for itself. Merges remain
# subject to that repository's branch protection and required status
# checks, enforced by GitHub itself.
AXIOM_GITHUB_TOKEN=
AXIOM_GITHUB_REPO=
